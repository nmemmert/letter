# Copy to .env and fill in your values

# ntfy topic — make it unguessable (anyone who knows it can receive/send)
# Subscribe at https://ntfy.sh/YOUR_TOPIC or in the ntfy app
NTFY_TOPIC=your-unguessable-topic-here

# Optional: self-hosted ntfy server
# NTFY_URL=https://ntfy.sh

# Optional: URL the notification links back to (your deployed app)
# APP_URL=http://localhost:8080

# Optional: cron schedule (default: 9 AM on the 1st of every month)
# CRON_SCHEDULE=0 9 1 * *

# Set to "true" to get a test ping the moment the notifier starts
# NTFY_TEST_ON_START=false
