# Copy this file to .env and fill in your values.
# docker-compose reads .env automatically for variable substitution.

# ── App ────────────────────────────────────────────────────────────────────────
# Port the web app is exposed on (default: 8080)
APP_PORT=8080

# ── ntfy ──────────────────────────────────────────────────────────────────────
# Required — your ntfy topic. Keep it unguessable (anyone with the name can sub).
# Subscribe at https://ntfy.sh/YOUR_TOPIC or in the ntfy iOS/Android app.
NTFY_TOPIC=your-unguessable-topic-here

# ntfy server — leave as-is for ntfy.sh, or point to your self-hosted instance
NTFY_URL=https://ntfy.sh

# Bearer token for private/access-controlled topics (leave blank for public)
NTFY_TOKEN=

# Notification priority: min | low | default | high | urgent
NTFY_PRIORITY=default

# ── Schedule ──────────────────────────────────────────────────────────────────
# Cron schedule for the monthly reminder (default: 9 AM on the 1st of each month)
# Format: minute hour day-of-month month day-of-week
CRON_SCHEDULE=0 9 1 * *

# IANA timezone for the cron schedule
TZ=America/Chicago

# URL the notification deep-links back to
APP_URL=http://localhost:8080

# Set to "true" to fire a test notification the moment the notifier container starts
NTFY_TEST_ON_START=false

# ── Dev ───────────────────────────────────────────────────────────────────────
# Port for the Vite dev server (docker compose --profile dev up dev)
DEV_PORT=5173
